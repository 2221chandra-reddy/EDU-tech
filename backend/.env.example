PORT=5000
NODE_ENV=development

# Local = 127.0.0.1 (this PC only). AWS/Docker production = 0.0.0.0
HOST=127.0.0.1

# memory | file | postgres
# file = demo DB persisted to DEMO_DB_PATH (recommended for local demos)
# memory = in-RAM only (resets on restart)
# postgres = production / real DATABASE_URL
DB_MODE=file
DEMO_DB_PATH=data/demo-db.json
DATABASE_URL=postgresql://postgres:password@localhost:5432/edugate
ALLOW_MEMORY_IN_PROD=false

# REQUIRED in production: long random string (32+ chars), not a default/demo value
JWT_SECRET=change-this-to-a-long-random-secret-min-32-chars
# Prefer shorter sessions in production (default 12h when NODE_ENV=production)
JWT_EXPIRES_IN=7d

# mock | openai | gemini
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-flash-latest

CLIENT_URL=http://localhost:5173
EXTRA_ORIGINS=

SERVE_FRONTEND=false
UPLOAD_DIR=uploads
MAX_UPLOAD_VIDEO_MB=200
MAX_UPLOAD_DOC_MB=40

SCHEDULER_INTERVAL_MS=30000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=100
