PORT=5000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
CLIENT_URL=http://localhost:5173
DB_MODE=file
DATABASE_URL=

AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Razorpay (India). Leave empty to use demo pay in development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Production demo checkout (off by default). Never enable on a public live site.
ALLOW_DEMO_PAY=false

# S3 for PDFs/notes (private bucket + signed URLs). All four required to enable.
AWS_S3_BUCKET=edugate-materials
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_SIGNED_URL_EXPIRES=3600
