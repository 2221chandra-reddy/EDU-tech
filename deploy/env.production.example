# Copy to deploy/.env.production on the EC2 server and fill real values.
# NEVER commit deploy/.env.production to git.

NODE_ENV=production
HOST=0.0.0.0
PORT=5000
SERVE_FRONTEND=true

# Browser URL users open (EC2 IP first, then your https domain)
CLIENT_URL=http://YOUR_EC2_PUBLIC_IP

# Required: 32+ random characters (not "change-me")
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=12h

# RDS PostgreSQL
DB_MODE=postgres
DATABASE_URL=postgresql://edugate:YOUR_PASSWORD@YOUR_RDS_ENDPOINT:5432/edugate

# mock | openai | gemini
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

UPLOAD_DIR=uploads
MAX_UPLOAD_VIDEO_MB=200
MAX_UPLOAD_DOC_MB=40

RATE_LIMIT_MAX=300
